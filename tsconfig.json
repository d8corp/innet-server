{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2018",
    "lib": [
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "removeComments": true,
    "declaration": false,
    "noEmit": true,
    "jsx": "react-jsxdev",
    "jsxImportSource": "@innet/jsx-runtime"
  },
  "include": [
    "src"
  ]
}
